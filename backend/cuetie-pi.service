[Unit]
Description=Cutie Pi Media Server
After=network.target multi-user.target weston.service
Wants=weston.service

[Service]
Type=simple
WorkingDirectory=/home/pi/cuetie-pi/backend
ExecStart=/home/pi/cuetie-pi/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=pi
SupplementaryGroups=video render
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/tmp/weston-runtime

[Install]
WantedBy=multi-user.target
