[Unit]
Description=Cutie Pi Media Server
After=network.target multi-user.target weston.service
Wants=weston.service

[Service]
Type=simple
WorkingDirectory=/home/pi/cuetie-pi/backend
Environment=PORT=8000
EnvironmentFile=/home/pi/cuetie-pi/backend/.env
ExecStart=/home/pi/cuetie-pi/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=5
User=pi
SupplementaryGroups=video render input
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/tmp/weston-runtime

[Install]
WantedBy=multi-user.target
